<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="400" prefWidth="600" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.zorkrip.ui.fx.SettingsController">

    <VBox alignment="CENTER" spacing="20" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <!-- MASTER VOLUME -->
        <HBox alignment="CENTER" spacing="10">
            <Label text="Master volume" />
            <Slider fx:id="masterVolumeSlider" prefWidth="200" />
        </HBox>

        <!-- MUSIC VOLUME -->
        <HBox alignment="CENTER" spacing="10">
            <Label text="Music volume" />
            <Slider fx:id="musicVolumeSlider" prefWidth="200" />
        </HBox>

        <!-- SFX VOLUME -->
        <HBox alignment="CENTER" spacing="10">
            <Label text="SFX volume" />
            <Slider fx:id="sfxVolumeSlider" prefWidth="200" />
        </HBox>
        <HBox alignment="CENTER" spacing="10">
            <Label text="Theme" />
            <RadioButton fx:id="theme" prefWidth="200" />
        </HBox>
        <!-- APPLY BUTTON -->
        <Button fx:id="applyButton" onAction="#apply" prefWidth="200" text="Apply" />
        <Button fx:id="backButton" onAction="#back" prefHeight="30" prefWidth="120" text="Back" />

    </VBox>

</AnchorPane>
