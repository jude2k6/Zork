<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
            fx:id="root"
            xmlns="http://javafx.com/javafx/17.0.12"
            fx:controller="org.zorkrip.ui.fx.SettingsController">

    <VBox alignment="CENTER" spacing="15"
          AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
          style="-fx-padding: 20;">

        <!-- Master Volume -->
        <HBox alignment="CENTER" spacing="10">
            <Label text="Master volume"/>
            <Slider fx:id="masterVolumeSlider" prefWidth="200" HBox.hgrow="NEVER"/>
        </HBox>

        <!-- Music Volume -->
        <HBox alignment="CENTER" spacing="10">
            <Label text="Music volume"/>
            <Slider fx:id="musicVolumeSlider" prefWidth="200" HBox.hgrow="NEVER"/>
        </HBox>

        <!-- SFX Volume -->
        <HBox alignment="CENTER" spacing="10">
            <Label text="SFX volume"/>
            <Slider fx:id="sfxVolumeSlider" prefWidth="200" HBox.hgrow="NEVER"/>
        </HBox>

        <!-- Theme -->
        <HBox alignment="CENTER" spacing="10">
            <Label text="Theme"/>
            <RadioButton fx:id="theme"/>
        </HBox>

        <!-- Buttons -->
        <HBox alignment="CENTER" spacing="15">
            <Button fx:id="applyButton" onAction="#apply" text="Apply" prefWidth="100"/>
            <Button fx:id="backButton" onAction="#back" text="Back" prefWidth="100"/>
        </HBox>

    </VBox>

</AnchorPane>
